#!/bin/sh
# Dipanggil dari autostart Hyprland. Service user yang jalan lewat linger bisa
# membangunkan xdg-desktop-portal SEBELUM login, tanpa XDG_CURRENT_DESKTOP →
# hyprland-portals.conf gak kebaca → ScreenCast hilang (OBS: "No capture sources").
# Impor env sesi dulu, lalu restart portal kalau env-nya basi.
dbus-update-activation-environment --systemd --all
pid=$(systemctl --user show -p MainPID --value xdg-desktop-portal 2>/dev/null)
if [ -n "$pid" ] && [ "$pid" != 0 ] && \
   ! tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -qx 'XDG_CURRENT_DESKTOP=Hyprland'; then
    systemctl --user reset-failed xdg-desktop-portal-gtk 2>/dev/null
    systemctl --user restart xdg-desktop-portal
fi
